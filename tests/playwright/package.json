{
  "name": "bandw-playwright-tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:bandw": "playwright test --project=bandw",
    "bddgen": "bddgen",
    "test:bdd:bandw": "npm run bddgen && playwright test --project=bandw-bdd",
    "test:bdd": "npm run bddgen && playwright test --project=bandw-bdd",
    "clean:manifests": "find tests -name '.manifest.json' -o -name '.manifest.lock' | xargs rm -f",
    "pretest": "npm run clean:manifests"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "playwright-bdd": "^8.5.1"
  }
}
