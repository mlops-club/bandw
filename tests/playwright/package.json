{
  "name": "bandw-playwright-tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:bandw": "playwright test --project=bandw",
    "test:wandb": "playwright test --project=wandb",
    "clean:manifests": "find tests -name '.manifest.json' -o -name '.manifest.lock' | xargs rm -f",
    "pretest": "npm run clean:manifests"
  },
  "devDependencies": {
    "@playwright/test": "latest"
  }
}
