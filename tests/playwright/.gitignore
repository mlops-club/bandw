# Auth state (session cookies, not committed)
.auth/

# SDK setup manifests (generated per test run)
**/.manifest.json
**/.manifest.lock

# Test output
test-results/
test-videos/
snapshots/
screenshots/

# wandb SDK run data
wandb/

# Node
node_modules/

# playwright-bdd generated specs (rebuilt by `npx bddgen`)
.features-gen/
